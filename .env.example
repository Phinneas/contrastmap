# Mapbox public token (browser-safe, meant to be exposed in client bundle)
# Get a free token at https://account.mapbox.com/access-tokens/
PUBLIC_MAPBOX_TOKEN=

# Mapbox secret token (server-side only, NEVER exposed to the browser).
# Used by scripts/geocode-coords.mjs to backfill real lat/lng into listings.json.
# Create one with "Secrets" scope at https://account.mapbox.com/access-tokens/
MAPBOX_TOKEN=
