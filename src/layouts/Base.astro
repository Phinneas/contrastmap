---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogType?: string;
  noindex?: boolean;
}

const {
  title = 'ContrastMap — Cold Plunge & Infrared Sauna Directory',
  description = 'ContrastMap is the directory for contrast therapy — find cold plunge and infrared sauna studios near you, and shop the best home tubs and saunas.',
  canonical,
  ogType = 'website',
  noindex = false,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="google-adsense-account" content="ca-pub-5424097145643842" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex,follow" />}
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  {canonical && <meta property="og:url" content={canonical} />}
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@10..48,400..800&family=Fraunces:opsz,wght@9..144,400..700&display=swap" rel="stylesheet" />
  <meta name="generator" content={Astro.generator} />
</head>
<body>

<!-- NAV -->
<header class="nav">
  <div class="wrap nav-in">
    <a href="/" class="brand">
      <svg width="34" height="34" viewBox="0 0 64 64"><defs><clipPath id="navmark"><circle cx="32" cy="32" r="30"></circle></clipPath></defs><g clip-path="url(#navmark)"><rect x="0" width="32" height="64" fill="#F97316"></rect><rect x="32" width="32" height="64" fill="#0EA5E9"></rect><rect x="30.3" width="3.4" height="64" fill="#FAF7F2"></rect></g><circle cx="32" cy="32" r="30" fill="none" stroke="rgba(15,23,42,.12)" stroke-width="1.5"></circle></svg>
      ContrastMap
    </a>
    <nav class="nav-links">
      <a href="/#studios">Find a studio</a>
      <a href="/states">States</a>
      <a href="/#shop">Shop</a>
      <a href="/#how">How it works</a>
      <a href="/#journal">Journal</a>
    </nav>
  </div>
</header>

<slot />

<!-- FOOTER -->
<footer class="lp-footer">
  <div class="lp-footer-in">
    <div>
      <div class="lp-footer-brand">
        <svg width="28" height="28" viewBox="0 0 64 64"><defs><clipPath id="footmark"><circle cx="32" cy="32" r="30"></circle></clipPath></defs><g clip-path="url(#footmark)"><rect x="0" width="32" height="64" fill="#F97316"></rect><rect x="32" width="32" height="64" fill="#0EA5E9"></rect><rect x="30.3" width="3.4" height="64" fill="#FAF7F2"></rect></g></svg>
        <span>ContrastMap</span>
      </div>
      <p>The directory for hot rooms and cold plunges — find a studio, bring it home.</p>
    </div>
    <div>
      <h4>Explore</h4>
      <div class="links">
        <a href="/#studios">Find a studio</a>
        <a href="/states">Browse by state</a>
        <a href="/#shop">Shop</a>
        <a href="/#journal">Journal</a>
        <a href="/#how">How it works</a>
      </div>
    </div>
    <div>
      <h4>Company</h4>
      <div class="links">
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
        <a href="/press">Press</a>
      </div>
    </div>
    <div>
      <h4>Legal</h4>
      <div class="links">
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
        <a href="/disclaimer">Disclaimer</a>
        <a href="/sitemap">Sitemap</a>
      </div>
    </div>
  </div>
  <div class="lp-footer-bot">&copy; 2026 ContrastMap. All rights reserved.</div>
</footer>

<!-- MODAL -->
<div class="modal-bg" id="modalBg">
  <div class="modal" role="dialog" aria-modal="true">
    <div class="modal-top">
      <button class="modal-x" onclick="closeModal()" aria-label="Close">&times;</button>
      <span class="eyebrow" id="modalEyebrow">Request info</span>
      <h3 id="modalTitle">Get a quote</h3>
      <p id="modalSub">Send your details and the studio will reach out with availability and pricing.</p>
    </div>
    <div class="modal-body" id="modalForm">
      <label>Your name</label>
      <input type="text" id="mName" placeholder="Jordan Rivers" />
      <label>Email</label>
      <input type="email" id="mEmail" placeholder="you@email.com" />
      <label id="mSvcLabel">Interested in</label>
      <select id="mSvc">
        <option>Contrast therapy (both)</option>
        <option>Cold plunge</option>
        <option>Infrared sauna</option>
        <option>A membership</option>
      </select>
      <button class="btn btn-grad" onclick="submitModal()">Send request</button>
    </div>
    <div class="modal-ok hidden" id="modalOk">
      <div class="check"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg></div>
      <h3>Request sent!</h3>
      <p id="modalOkMsg">The studio will be in touch soon.</p>
    </div>
  </div>
</div>

<script is:inline>
function openQuote(name){
  document.getElementById('modalEyebrow').textContent='Get a quote';
  document.getElementById('modalTitle').textContent=name;
  document.getElementById('modalSub').textContent='Send your details and this studio will reach out with availability and pricing.';
  document.getElementById('mSvcLabel').textContent='Interested in';
  document.getElementById('modalOkMsg').textContent=`${name} will be in touch soon. (Demo — nothing was actually sent.)`;
  showModal();
}
function showModal(){
  document.getElementById('modalForm').classList.remove('hidden');
  document.getElementById('modalOk').classList.add('hidden');
  document.getElementById('modalBg').classList.add('open');
}
function closeModal(){ document.getElementById('modalBg').classList.remove('open'); }
function submitModal(){
  document.getElementById('modalForm').classList.add('hidden');
  document.getElementById('modalOk').classList.remove('hidden');
}
document.getElementById('modalBg').addEventListener('click',function(e){
  if(e.target===document.getElementById('modalBg')) closeModal();
});
document.addEventListener('keydown',function(e){ if(e.key==='Escape') closeModal(); });
</script>

<!-- COOKIE CONSENT (GDPR: shown until the visitor accepts or declines; choice is stored locally) -->
<div id="cmConsent" class="cm-consent" hidden>
  <p>We use cookies for site functionality and, where enabled, personalized ads via Google AdSense. See our <a href="/privacy">Privacy Policy</a>.</p>
  <div class="cm-consent-btns">
    <button type="button" id="cmConsentNo" class="cm-btn cm-btn-ghost">Decline</button>
    <button type="button" id="cmConsentYes" class="cm-btn">Accept</button>
  </div>
</div>
<style>
  .cm-consent{position:fixed;left:16px;right:16px;bottom:16px;z-index:400;max-width:520px;margin:0 auto;background:#0B1220;color:#dbe4f0;border-radius:14px;padding:16px 18px;display:flex;align-items:center;gap:16px;box-shadow:0 12px 32px rgba(2,6,23,.35);font-size:.85rem;line-height:1.5}
  .cm-consent[hidden]{display:none}
  .cm-consent p{margin:0;flex:1}
  .cm-consent a{color:#7DD3FC}
  .cm-consent-btns{display:flex;gap:8px;flex:none}
  .cm-btn{font:inherit;font-weight:600;padding:8px 16px;border-radius:9px;border:none;cursor:pointer;background:#0EA5E9;color:#fff}
  .cm-btn-ghost{background:transparent;color:#94A3B8;border:1px solid #334155}
  @media(max-width:560px){.cm-consent{flex-direction:column;align-items:stretch;text-align:center}.cm-consent-btns{justify-content:center}}
</style>
<script is:inline>
(function(){
  var KEY='cm-consent-v1';
  var bar=document.getElementById('cmConsent');
  try{ if(localStorage.getItem(KEY)) return; }catch(e){}
  bar.hidden=false;
  function set(v){ try{ localStorage.setItem(KEY,v); }catch(e){} bar.hidden=true; }
  document.getElementById('cmConsentYes').addEventListener('click',function(){ set('accepted'); });
  document.getElementById('cmConsentNo').addEventListener('click',function(){ set('declined'); });
})();
</script>

</body>
</html>
