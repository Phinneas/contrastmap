---
import Base from '../layouts/Base.astro';
import '../styles/global.css';
import listingsData from '../data/listings.json';
import catalogRaw from '../data/catalog.json';
import { STATES } from '../lib/states';
import { CITIES } from '../lib/cities';

// City data for search routing (lowercased name -> slug, all covered metros)
const CITY_SLUGS = Object.fromEntries(
  CITIES.map((c) => [c.name.toLowerCase(), c.slug]),
);

// Transform listings to card format for featured studios
function listingToCardData(l) {
  const services = [];
  if (l.amenities.coldPlunge) services.push('Cold Plunge');
  if (l.amenities.infraredSauna) services.push('Infrared Sauna');
  if (l.amenities.contrastTherapyMarketed) services.push('Contrast Therapy');
  if (l.amenities.redLightTherapy) services.push('Red Light');
  return {
    name: l.name,
    city: l.location.city,
    state: l.location.state,
    neighborhood: l.location.neighborhood,
    services,
    slug: l.slug,
    featured: l.editorial.featured,
  };
}

const allListings = listingsData.listings.map(listingToCardData);
const featuredStudios = allListings.filter(l => l.featured).slice(0, 3);

// Pick 3 products for shop teaser
const PRODUCTS = catalogRaw.filter(x => !x._note);
const shopProducts = [
  PRODUCTS.find(p => p.name === 'Ice Barrel 300'),
  PRODUCTS.find(p => p.name === 'Sun Home Equinox 2-Person Full-Spectrum Infrared Sauna'),
  PRODUCTS.find(p => p.name === 'HigherDOSE Infrared Sauna Blanket'),
].filter(Boolean);

// Journal articles (glyph + gradient give each card a distinct, self-contained image)
const articles = [
  {
    category: 'Guide',
    title: 'Contrast Therapy 101',
    excerpt: "What it is, how it works, and who it's for — including the part almost nobody explains: there are two different protocols that share the same name.",
    href: '/learn/contrast-therapy-101',
    glyph: '\u21c4',
    gradient: 'linear-gradient(135deg,#0EA5E9 0%,#7C9EDE 50%,#F97316 100%)',
  },
  {
    category: 'Science',
    title: 'Cold Plunge Benefits: The Science-Backed List',
    excerpt: "A claim-by-claim breakdown graded by evidence strength — what the research actually supports vs. what's overhyped.",
    href: '/learn/cold-plunge-benefits',
    glyph: '\u2744',
    gradient: 'linear-gradient(135deg,#38BDF8,#0369A1)',
  },
  {
    category: 'Comparison',
    title: 'Cold Plunge vs Infrared Sauna',
    excerpt: 'Which is better for recovery, sleep, and mood — and why doing both wins.',
    href: '/learn/cold-plunge-vs-infrared-sauna',
    glyph: '\u2696',
    gradient: 'linear-gradient(135deg,#0EA5E9 0%,#A78BFA 55%,#F97316 100%)',
  },
  {
    category: 'Comparison',
    title: 'Infrared vs Traditional Sauna',
    excerpt: 'Two very different ways to sweat. Which one is right for recovery, relaxation, and your budget?',
    href: '/learn/infrared-vs-traditional-sauna',
    glyph: '\u2668',
    gradient: 'linear-gradient(135deg,#FB923C,#C2410C)',
  },
  {
    category: 'Cost Guide',
    title: 'Membership vs Drop-In',
    excerpt: 'When does paying per session make sense, and when is a membership the better deal?',
    href: '/learn/cold-plunge-membership-vs-dropin',
    glyph: '$',
    gradient: 'linear-gradient(135deg,#FBBF24,#EA580C)',
  },
  {
    category: 'Research',
    title: 'Infrared Sauna EMF: What the Standards Say',
    excerpt: "\"Low EMF\" isn't regulated, and most numbers come from tests the brand paid for. Here's what the real standards say.",
    href: '/learn/infrared-sauna-emf-testing',
    glyph: '\u26a1',
    gradient: 'linear-gradient(135deg,#818CF8,#4F46E5)',
  },
  {
    category: 'Research',
    title: 'Cold Plunge Chiller Reliability Index',
    excerpt: 'An independent reliability index for cold plunge chillers — methodology, initial findings, and why no one else has published this before.',
    href: '/learn/cold-plunge-chiller-reliability-index',
    glyph: '\u271a',
    gradient: 'linear-gradient(135deg,#2DD4BF,#0F766E)',
  },
  {
    category: 'Guide',
    title: 'Why Am I Not Sweating in My Infrared Sauna?',
    excerpt: "It's common — and usually normal. How infrared heat works differently, and how to get more from your sessions.",
    href: '/learn/not-sweating-in-infrared-sauna',
    glyph: '\u2601',
    gradient: 'linear-gradient(135deg,#F97316,#9A3412)',
  },
  {
    category: 'Comparison',
    title: 'Contrast Bath vs. Contrast Therapy vs. Sauna Combo',
    excerpt: "Contrast bath is the clinical term, contrast therapy is the umbrella, and sauna combo is the equipment. Here's what each one actually means.",
    href: '/learn/contrast-bath-vs-contrast-therapy-vs-sauna-combo',
    glyph: '\u2194',
    gradient: 'linear-gradient(135deg,#38BDF8 0%,#64748B 50%,#F97316 100%)',
  },
  {
    category: 'Buying Guide',
    title: 'Cold Plunge Chillers: The Types That Actually Exist',
    excerpt: 'Integrated, external, or portable — plus cooling method, plumbing, and capacity. How to map yourself to the right chiller type.',
    href: '/learn/cold-plunge-chiller-types',
    glyph: '\u2699',
    gradient: 'linear-gradient(135deg,#22D3EE,#0369A1)',
  },
];
---

<style>
  .lp-geo-btn{display:inline-flex;align-items:center;gap:6px;font-family:var(--font-d);font-weight:600;font-size:.9rem;padding:0 14px;border:1px solid var(--line);border-radius:10px;background:var(--white);color:var(--ink-2);cursor:pointer;transition:all .15s;white-space:nowrap}
  .lp-geo-btn:hover{border-color:var(--cold-2);color:var(--cold-2)}
  .lp-geo-btn svg{flex:none}
</style>

<Base>
  <span id="top"></span>

  <!-- HERO -->
  <section class="lp-hero">
    <div>
      <span class="eyebrow" style="color:var(--hot-2)">Find your temperature</span>
      <h1>Hot rooms and cold plunges, found in seconds.</h1>
      <p class="subhead">The friendliest way to find a sauna or cold plunge nearby — and everything you need to build the ritual at home.</p>

      <form class="lp-searchbar" id="heroSearch" autocomplete="off">
        <input type="text" id="heroCity" placeholder="Enter your city or zip code" />
        <select id="heroType" aria-label="Studio type">
          <option value="">Any type</option>
          <option value="cold-plunge">Cold plunge</option>
          <option value="infrared-sauna">Sauna</option>
          <option value="contrast-therapy">Both</option>
        </select>
        <button type="submit">Search</button>
        <button type="button" id="heroGeo" class="lp-geo-btn" title="Use my location">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="4"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/></svg>
          <span>Near me</span>
        </button>
      </form>

      <div class="lp-trust">
        <span><span class="dot"></span><b>{allListings.length}+</b> studios listed</span>
        <span><span class="dot"></span>free to browse</span>
      </div>
    </div>

    <div class="lp-hero-visual" aria-hidden="true">
      <svg class="mark-lg" viewBox="0 0 64 64">
        <defs><clipPath id="heromark"><circle cx="32" cy="32" r="30"></circle></clipPath></defs>
        <g clip-path="url(#heromark)">
          <rect x="0" width="32" height="64" fill="#F97316"></rect>
          <rect x="32" width="32" height="64" fill="#0EA5E9"></rect>
          <rect x="30.3" width="3.4" height="64" fill="#FAF7F2"></rect>
          <circle cx="20" cy="24" r="5.5" fill="#fff" opacity=".28"></circle>
          <circle cx="44" cy="40" r="5.5" fill="#fff" opacity=".28"></circle>
        </g>
        <circle cx="32" cy="32" r="30" fill="none" stroke="rgba(15,23,42,.12)" stroke-width="1.5"></circle>
      </svg>
      <div class="lp-chip hot">
        <span class="sw"></span>
        190°F sauna
      </div>
      <div class="lp-chip cold">
        <span class="sw"></span>
        39°F plunge
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section id="how" class="lp-how">
    <div class="lp-sec-head">
      <span class="eyebrow" style="color:var(--cold-2)">How it works</span>
      <h2>Three steps to your next reset</h2>
    </div>
    <div class="lp-how-grid">
      <div class="lp-step">
        <div class="ic hot-bg">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#EA580C" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.3-4.3"></path></svg>
        </div>
        <span class="step-lbl">Step 1</span>
        <h3>Search your area</h3>
        <p>Enter a city or zip and filter by sauna, cold plunge, or both.</p>
      </div>
      <div class="lp-step">
        <div class="ic cold-bg">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0369A1" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="5" width="16" height="15" rx="2"></rect><path d="M8 3v4M16 3v4M4 10h16"></path></svg>
        </div>
        <span class="step-lbl">Step 2</span>
        <h3>Compare studios</h3>
        <p>See amenities, hours, and member reviews side by side.</p>
      </div>
      <div class="lp-step">
        <div class="ic hot-bg">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#EA580C" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>
        </div>
        <span class="step-lbl">Step 3</span>
        <h3>Book your session</h3>
        <p>Reserve directly with the studio — no account needed.</p>
      </div>
    </div>
  </section>

  <!-- FEATURED STUDIOS -->
  <section id="studios" class="lp-studios">
    <div class="lp-sec-row">
      <div>
        <span class="eyebrow" style="color:var(--hot-2)">Featured on ContrastMap</span>
        <h2 style="font-family:var(--font-d);font-weight:600;font-size:clamp(1.7rem,3vw,2.3rem);letter-spacing:-.02em;margin-top:10px">Studios our members love</h2>
      </div>
      <a href="/austin" class="lp-link">Browse all studios →</a>
    </div>
    <div class="lp-studio-grid">
      {featuredStudios.map(s => (
        <a class="lp-studio-card" href={`/${CITY_SLUGS[s.city.toLowerCase()]}/${s.slug}`}>
          <div class="thumb"><span>studio photo</span></div>
          <div class="body">
            <h3>{s.name}</h3>
            <span class="city">{s.city}, {s.state}</span>
            <div class="tags">
              {s.services.slice(0, 3).map(tag => <span class="tag">{tag}</span>)}
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- BROWSE BY CITY -->
  <section style="max-width:var(--maxw);margin:0 auto;padding:40px 40px;text-align:center">
    <span class="eyebrow" style="color:var(--cold-2)">Browse by city</span>
    <h2 style="font-family:var(--font-d);font-weight:600;font-size:clamp(1.7rem,3vw,2.3rem);letter-spacing:-.02em;margin-top:10px">Find studios near you</h2>
    <div style="display:flex;flex-wrap:wrap;gap:10px;justify-content:center;margin-top:22px">
      {CITIES.map(c => c.live ? (
        <a href={`/${c.slug}`} style="font-family:var(--font-d);font-size:.92rem;font-weight:500;padding:8px 18px;border-radius:999px;background:var(--panel);color:var(--ink);border:1px solid var(--line)">{c.name}</a>
      ) : (
        <a href={`/${c.slug}`} class="lp-city-soon">{c.name}<span class="soon">Soon</span></a>
      ))}
    </div>
    <div style="margin-top:20px">
      <span class="eyebrow" style="color:var(--hot-2);font-size:.68rem">Browse by state</span>
      <div style="display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin-top:12px">
        {STATES.map((s) => (
          <a href={`/states/${s.slug}`} style="font-family:var(--font-d);font-size:.84rem;font-weight:500;padding:6px 14px;border-radius:999px;background:var(--white);color:var(--ink-2);border:1px solid var(--line)">{s.name}</a>
        ))}
      </div>
    </div>
  </section>

  <!-- BENEFITS -->
  <section class="lp-benefits">
    <div class="lp-sec-head">
      <span class="eyebrow" style="color:var(--cold-2)">Why contrast therapy</span>
      <h2>What hot-and-cold does for you</h2>
    </div>
    <div class="lp-benefits-grid">
      <div class="lp-benefit">
        <div class="ic cold-bg">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0369A1" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v4M12 18v4M4.9 4.9l2.8 2.8M16.3 16.3l2.8 2.8M2 12h4M18 12h4M4.9 19.1l2.8-2.8M16.3 7.7l2.8-2.8"></path></svg>
        </div>
        <h4>Sharper focus</h4>
        <p>Cold exposure spikes alertness for hours after.</p>
      </div>
      <div class="lp-benefit">
        <div class="ic hot-bg">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#EA580C" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-4.35-9.5-8.5C.7 8.7 2.6 5 6.2 5 8.4 5 10 6.2 12 8c2-1.8 3.6-3 5.8-3 3.6 0 5.5 3.7 3.7 7.5C19 16.65 12 21 12 21z"></path></svg>
        </div>
        <h4>Faster recovery</h4>
        <p>Contrast cycles reduce muscle soreness after training.</p>
      </div>
      <div class="lp-benefit">
        <div class="ic cold-bg">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0369A1" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z"></path></svg>
        </div>
        <h4>Better sleep</h4>
        <p>The heat-then-cool drop mimics your body's natural wind-down.</p>
      </div>
      <div class="lp-benefit">
        <div class="ic hot-bg">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#EA580C" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M8 14s1.5 2 4 2 4-2 4-2M9 9h.01M15 9h.01"></path></svg>
        </div>
        <h4>Stress relief</h4>
        <p>Members report calmer, clearer heads within a few sessions.</p>
      </div>
    </div>
  </section>

  <!-- SHOP TEASER -->
  <section id="shop" class="lp-shop">
    <div class="lp-sec-row">
      <div>
        <span class="eyebrow" style="color:var(--hot-2)">Gear up</span>
        <h2 style="font-family:var(--font-d);font-weight:600;font-size:clamp(1.7rem,3vw,2.3rem);letter-spacing:-.02em;margin-top:10px">Bring the ritual home</h2>
      </div>
      <a href="/#shop" class="lp-link">Visit the shop →</a>
    </div>
    <div class="lp-shop-grid">
      {shopProducts.map(p => (
        <a class="lp-product-card" href={p.website} target="_blank" rel="noopener noreferrer">
          <div class="thumb"><span>product photo</span></div>
          <div class="body">
            <h3>{p.name}</h3>
            <span class="price">{p.priceNote}</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- JOURNAL -->
  <section id="journal" class="lp-journal">
    <div class="lp-sec-head">
      <span class="eyebrow" style="color:var(--cold-2)">From the journal</span>
      <h2>Stories & guides</h2>
    </div>
    <div class="lp-journal-grid">
      {articles.map(a => (
        <a class="lp-article-card" href={a.href}>
          <div class="thumb" style={`background:${a.gradient}`} aria-hidden="true">
            <span class="journal-glyph">{a.glyph}</span>
          </div>
          <div class="body">
            <span class="cat">{a.category}</span>
            <h3>{a.title}</h3>
            <p>{a.excerpt}</p>
          </div>
        </a>
      ))}

    </div>
  </section>

  <!-- NEWSLETTER -->
  <section class="lp-newsletter">
    <div class="lp-newsletter-in">
      <h2>Get the cold email.</h2>
      <p>New studios, seasonal guides, and the occasional cold-plunge dare — once a week.</p>
      <form class="lp-newsletter-form" id="newsletterForm">
        <input type="email" id="newsletterEmail" placeholder="you@example.com" required />
        <button type="submit">Subscribe</button>
      </form>
      <div class="lp-newsletter-ok" id="newsletterOk">You're subscribed! Check your inbox for a welcome email.</div>
    </div>
  </section>

  <!-- Client JS -->
  <script is:inline define:vars={{ CITY_SLUGS }}>
    const heroSearch = document.getElementById('heroSearch');
    if (heroSearch) {
      heroSearch.addEventListener('submit', e => {
        e.preventDefault();
        const raw = document.getElementById('heroCity').value.trim();
        const input = raw.toLowerCase();
        const type = document.getElementById('heroType').value;
        const amenity = type ? `&amenity=${encodeURIComponent(type)}` : '';
        // 5-digit zip -> proximity search
        if (/^\d{5}$/.test(raw)) {
          window.location.href = `/search?zip=${raw}${amenity}`;
          return;
        }
        // city name -> city page
        const cityMatch = Object.keys(CITY_SLUGS).find(c => c.includes(input) || input.includes(c));
        if (cityMatch) {
          window.location.href = '/' + CITY_SLUGS[cityMatch] + (type ? `?amenity=${encodeURIComponent(type)}` : '');
        } else {
          const el = document.getElementById('heroCity');
          el.focus();
          el.style.borderColor = '#F97316';
          el.placeholder = 'Try a city or 5-digit zip';
        }
      });
    }

    const heroGeo = document.getElementById('heroGeo');
    if (heroGeo && navigator.geolocation) {
      heroGeo.addEventListener('click', () => {
        heroGeo.querySelector('span').textContent = 'Locating\u2026';
        navigator.geolocation.getCurrentPosition(
          (pos) => {
            const lat = pos.coords.latitude.toFixed(4);
            const lng = pos.coords.longitude.toFixed(4);
            const type = document.getElementById('heroType').value;
            window.location.href = `/search?lat=${lat}&lng=${lng}${type ? '&amenity=' + encodeURIComponent(type) : ''}`;
          },
          () => {
            heroGeo.querySelector('span').textContent = 'Near me';
            alert('Could not get your location. Enter a zip code instead.');
          },
          { timeout: 10000 }
        );
      });
    }

    const newsletterForm = document.getElementById('newsletterForm');
    if (newsletterForm) {
      newsletterForm.addEventListener('submit', async e => {
        e.preventDefault();
        const email = document.getElementById('newsletterEmail').value;
        try {
          await fetch('/api/newsletter', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email }),
          });
        } catch (err) {
          // Fallback: still show success even if API fails (demo mode)
        }
        newsletterForm.style.display = 'none';
        document.getElementById('newsletterOk').style.display = 'block';
      });
    }
  </script>
</Base>
